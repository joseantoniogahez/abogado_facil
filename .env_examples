# Template for Docker Compose local configuration.
# Copy this file to .env and customize values for your machine.

# ------------------------------------------------------------
# API SERVICE (FastAPI container + runtime behavior)
# ------------------------------------------------------------
# API_HOST: backend container name/hostname used inside the Docker network.
API_HOST=abogado_facil_api

# APP_ENV: backend runtime environment (local, test, prod).
# In prod, JWT_* and AI_CREDENTIAL_ENCRYPTION_KEY become required and validated strictly.
APP_ENV=local

# API_PORT: backend port exposed on host and used by the backend container.
API_PORT=8000

# API_PATH: FastAPI root_path metadata (useful behind a reverse proxy).
# Canonical local contract mounts API routes at root, so keep this empty.
API_PATH=

# API_CORS_ORIGINS: comma-separated explicit http(s) browser origins, without paths or '*'.
API_CORS_ORIGINS=http://localhost:3000

# LOG_LEVEL: backend logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=WARNING

# RATE LIMITING (shared Redis in Compose/production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=redis
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_UPLOAD=30
RATE_LIMIT_WINDOW_SECONDS=60

# AI JOB QUEUE (RQ worker; Redis carries execution IDs only)
AI_QUEUE_NAME=ai
AI_QUEUE_JOB_TIMEOUT_SECONDS=120
AI_QUEUE_MAX_RETRIES=3
AI_QUEUE_RETRY_BACKOFF_SECONDS=10,30,60
AI_QUEUE_RESULT_TTL_SECONDS=0
AI_QUEUE_FAILURE_TTL_SECONDS=86400
AI_QUEUE_TTL_SECONDS=300

# FILE AND AI INPUT/OUTPUT LIMITS
MATTER_DOCUMENT_MAX_SIZE_BYTES=10485760
MATTER_DOCUMENT_MAX_PER_MATTER=50
AI_INPUT_MAX_CHARS=20000
AI_OUTPUT_MAX_TOKENS=1200
DOCUMENT_DRAFT_FIELD_MAX_CHARS=20000
DOCUMENT_DRAFT_OUTPUT_MAX_TOKENS=1800

# ------------------------------------------------------------
# AUTH SERVICE (JWT signing and expiration)
# ------------------------------------------------------------
# JWT_SECRET_KEY: JWT signing secret.
# Local/test can use this default. In prod set a strong random secret.
JWT_SECRET_KEY=local-dev-jwt-secret-change-me-now  # pragma: allowlist secret

# JWT_ALGORITHM: JWT algorithm.
JWT_ALGORITHM=HS256

# JWT_ACCESS_TOKEN_EXPIRE_MINUTES: access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT_ISSUER: expected JWT issuer claim.
JWT_ISSUER=abogado-facil

# JWT_AUDIENCE: expected JWT audience claim.
JWT_AUDIENCE=abogado-facil-api

# AI_CREDENTIAL_ENCRYPTION_KEY: URL-safe base64 for exactly 32 random bytes.
# The value below is local-only. Generate and set a unique value before production startup.
AI_CREDENTIAL_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=  # pragma: allowlist secret

# ------------------------------------------------------------
# DATABASE SERVICE (PostgreSQL connection for backend)
# ------------------------------------------------------------
# DB_HOST: database container hostname in the Docker network.
DB_HOST=abogado_facil_db

# DB_PORT: PostgreSQL port exposed on host.
DB_PORT=5432

# DB_NAME: PostgreSQL database name.
DB_NAME=abogado_facil_main

# DB_USER: PostgreSQL username.
DB_USER=my_admin

# DB_PASSWORD: PostgreSQL password (change before first run).
DB_PASSWORD=REPLACE_ME  # pragma: allowlist secret

# DB_TYPE: SQLAlchemy async driver for PostgreSQL.
DB_TYPE=postgresql+asyncpg

# ------------------------------------------------------------
# OBJECT STORAGE (private S3-compatible bucket)
# ------------------------------------------------------------
# Local-only defaults. Production requires explicit non-placeholder credentials.
S3_ENDPOINT_URL=http://object-storage:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin  # pragma: allowlist secret
S3_SECRET_KEY=minioadmin  # pragma: allowlist secret
S3_PATH_STYLE=true
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10

# MinIO ports are published only by the development override.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------
# FRONTEND SERVICE (Vite + React container network/port settings)
# ------------------------------------------------------------
# UI_HOST: frontend container name/hostname used in Docker network.
UI_HOST=abogado_facil_frontend

# UI_PORT: frontend port exposed on host.
UI_PORT=3000

# VITE_API_ORIGIN: API origin consumed by browser-side frontend code.
# If API_PORT changes, update this value accordingly.
VITE_API_ORIGIN=http://localhost:8000

# VITE_API_BASE_PATH: API base path consumed by browser-side frontend code.
# Canonical contract uses versioned API routes.
VITE_API_BASE_PATH=/v1

# UI_PATH: reserved for proxy/path-based deployments (not consumed directly here).
UI_PATH=/

# ------------------------------------------------------------
# BUILD AND CONTAINER LOGGING (optional tuning)
# ------------------------------------------------------------
# PYTHON_VERSION: Python version used to build the backend image.
PYTHON_VERSION=3.14

# BACKEND_LOG_MAX_SIZE: max size per backend container log file.
BACKEND_LOG_MAX_SIZE=10m

# BACKEND_LOG_MAX_FILE: max number of rotated backend log files.
BACKEND_LOG_MAX_FILE=3
